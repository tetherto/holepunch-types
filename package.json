{
  "name": "holepunch-types",
  "version": "0.1.0",
  "description": "TypeScript type definitions for Holepunch ecosystem modules: autobase, blind-pairing, hyperswarm, z32, b4a, and more.",
  "types": "@types/index.d.ts",
  "exports": {
    ".": {
      "types": "./@types/index.d.ts"
    },
    "./@types/*": "./@types/*",
    "./package.json": "./package.json"
  },
  "files": [
    "@types/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tetherto/holepunch-types.git"
  },
  "keywords": [
    "types",
    "typescript",
    "holepunch",
    "autobase",
    "hyperswarm",
    "blind-pairing",
    "z32",
    "b4a",
    "corestore"
  ],
  "author": "Tether Inc",
  "license": "Apache-2.0",
  "scripts": {
    "lint": "prettier . --check",
    "test": "tsc -p tsconfig.json --noEmit",
    "format": "prettier . --write"
  },
  "tsd": {
    "directory": "test",
    "compilerOptions": {
      "strict": true,
      "target": "ES2020",
      "lib": [
        "ES2020"
      ],
      "types": [
        "node"
      ],
      "typeRoots": [
        "./@types"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.9.6",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/node": "^24.3.0"
  },
  "bugs": {
    "url": "https://github.com/tetherto/holepunch-types/issues"
  },
  "homepage": "https://github.com/tetherto/holepunch-types"
}
